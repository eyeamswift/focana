# Supabase — used for beta signup storage
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Loops — used for email marketing (server-side only)
LOOPS_API_KEY=your-loops-api-key

# GitHub Releases — public installer downloads used in the landing flow
PUBLIC_GITHUB_ARM64_DMG_URL=https://github.com/eyeamswift/focana/releases/download/vX.Y.Z/Focana-X.Y.Z-mac-arm64.dmg
PUBLIC_GITHUB_X64_DMG_URL=https://github.com/eyeamswift/focana/releases/download/vX.Y.Z/Focana-X.Y.Z-mac-x64.dmg
PUBLIC_SITE_URL=https://focana.app
PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
PUBLIC_BING_SITE_VERIFICATION=your-bing-site-verification-token

# Lemon Squeezy — checkout, webhooks, and legacy signed file downloads
PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-checkout-id?embed=1
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_ARM64_FILE_ID=your-arm64-file-id
LEMONSQUEEZY_X64_FILE_ID=your-x64-file-id
