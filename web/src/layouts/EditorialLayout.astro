---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { SITE_NAME } from '../data/site';
import { SITE_ORIGIN } from '../lib/siteOrigin';

interface Props {
  title: string;
  description: string;
  canonicalURL: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonicalURL,
  ogImage = `${SITE_ORIGIN}/og-image.png`,
  ogImageAlt,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const schemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const checkoutUrl = '/download';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_NAME} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schemas.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <meta name="generator" content={Astro.generator} />
    <script src="https://assets.lemonsqueezy.com/lemon.js" defer></script>

    <slot name="head" />

    <style>
      :root {
        --bg: #fffef8;
        --bg-soft: rgba(255, 249, 230, 0.84);
        --bg-panel: rgba(255, 255, 255, 0.92);
        --line: #e5d4b1;
        --text: #5c4033;
        --muted: #8b6f47;
        --muted-soft: #7a6548;
        --accent: #f59e0b;
        --accent-deep: #d97706;
        --shadow: 0 24px 60px rgba(92, 64, 51, 0.12);
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        background:
          radial-gradient(circle at top, rgba(245, 158, 11, 0.12), transparent 30%),
          radial-gradient(circle at 18% 16%, rgba(245, 158, 11, 0.08), transparent 24%),
          linear-gradient(160deg, #fffef8 0%, #fff9e6 54%, rgba(254, 243, 199, 0.3) 100%),
          var(--bg);
        color: var(--text);
      }

      a {
        color: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      button:focus-visible,
      a:focus-visible {
        outline: 3px solid rgba(217, 119, 6, 0.9);
        outline-offset: 3px;
        border-radius: 12px;
      }

      .site-nav {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(22px);
        background: rgba(255, 254, 248, 0.84);
        border-bottom: 1px solid rgba(229, 212, 177, 0.7);
      }

      .nav-inner,
      .mobile-drawer-inner,
      .site-footer {
        width: min(1180px, calc(100% - 48px));
        margin: 0 auto;
      }

      .nav-inner {
        min-height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand-link {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        box-shadow: 0 12px 28px rgba(92, 64, 51, 0.14);
      }

      .brand-name {
        font-family: 'Outfit', sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.04em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 26px;
      }

      .nav-link,
      .product-trigger,
      .mobile-link,
      .mobile-product-trigger {
        font-size: 15px;
        font-weight: 500;
        color: var(--muted);
        text-decoration: none;
        background: none;
        border: none;
        cursor: pointer;
        transition: color 0.2s ease;
      }

      .nav-link:hover,
      .product-trigger:hover,
      .product-item:hover,
      .footer-link:hover,
      .mobile-link:hover,
      .mobile-product-trigger:hover {
        color: var(--text);
      }

      .product-shell {
        position: relative;
      }

      .product-trigger {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .product-dropdown {
        position: absolute;
        top: calc(100% + 14px);
        left: -12px;
        min-width: 230px;
        padding: 10px;
        border-radius: 18px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.98);
        box-shadow: var(--shadow);
      }

      .product-item {
        display: block;
        padding: 12px 14px;
        border-radius: 12px;
        text-decoration: none;
        color: var(--muted);
        transition: background 0.2s ease, color 0.2s ease;
      }

      .product-item:hover {
        background: var(--bg-soft);
      }

      .download-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 20px;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, var(--accent), var(--accent-deep));
        box-shadow: 0 14px 34px rgba(217, 119, 6, 0.24);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .download-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 18px 38px rgba(217, 119, 6, 0.3);
      }

      .mobile-toggle {
        display: none;
        width: 44px;
        height: 44px;
        border: none;
        background: none;
        color: var(--text);
        cursor: pointer;
      }

      .mobile-drawer {
        display: none;
        border-bottom: 1px solid rgba(229, 212, 177, 0.9);
        background: rgba(255, 254, 248, 0.98);
      }

      .mobile-drawer-inner {
        padding: 18px 0 22px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .mobile-link,
      .mobile-product-trigger {
        font-size: 16px;
        text-align: left;
      }

      .mobile-product-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .mobile-product-links {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding-left: 16px;
        border-left: 2px solid rgba(229, 212, 177, 0.9);
      }

      .site-footer {
        padding: 0 0 56px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        color: var(--muted-soft);
      }

      .footer-links {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
      }

      .footer-link {
        text-decoration: none;
        color: var(--muted-soft);
        transition: color 0.2s ease;
      }

      .checkout-error {
        position: fixed;
        top: 96px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 40;
        width: min(90vw, 420px);
        padding: 12px 16px;
        border-radius: 14px;
        background: #5c4033;
        color: #fff;
        box-shadow: 0 18px 40px rgba(92, 64, 51, 0.2);
        text-align: center;
        font-size: 14px;
        line-height: 1.5;
      }

      @media (max-width: 960px) {
        .nav-links {
          display: none;
        }

        .mobile-toggle,
        .mobile-drawer {
          display: block;
        }
      }

      @media (max-width: 720px) {
        .nav-inner,
        .mobile-drawer-inner,
        .site-footer {
          width: min(100% - 32px, 1180px);
        }

        .site-footer {
          padding-bottom: 44px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-nav">
      <div class="nav-inner">
        <a href="/" class="brand-link" aria-label="Focana home">
          <img src="/favicon.png" alt="" class="brand-mark" width="42" height="42" />
          <span class="brand-name">Focana</span>
        </a>

        <div class="nav-links">
          <div class="product-shell" data-product-shell>
            <button class="product-trigger" type="button" aria-expanded="false" aria-haspopup="true" data-product-toggle>
              <span>Product</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.25 4.5 6 8.25 9.75 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
            <div class="product-dropdown" data-product-dropdown hidden>
              <a href={checkoutUrl} class="product-item" data-checkout-trigger data-checkout-location="editorial_product_dropdown">Download Focana</a>
              <a href="/updates" class="product-item">Updates</a>
            </div>
          </div>
          <a href="/#features" class="nav-link">How it Works</a>
          <a href="/#pricing" class="nav-link">Pricing</a>
          <a href="/blog/" class="nav-link">Resources</a>
          <a href="/#faq" class="nav-link">FAQ</a>
          <a href={checkoutUrl} class="download-btn" data-checkout-trigger data-checkout-location="editorial_nav_download">Download</a>
        </div>

        <button class="mobile-toggle" type="button" aria-expanded="false" aria-label="Open menu" data-mobile-toggle>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 6H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            <path d="M3 12H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            <path d="M3 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>

      <div class="mobile-drawer" data-mobile-drawer hidden>
        <div class="mobile-drawer-inner">
          <button class="mobile-product-trigger" type="button" aria-expanded="false" data-mobile-product-toggle>
            <span>Product</span>
            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2.25 4.5 6 8.25 9.75 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <div class="mobile-product-links" data-mobile-product-links hidden>
            <a href={checkoutUrl} class="mobile-link" data-checkout-trigger data-checkout-location="editorial_mobile_product_dropdown">Download Focana</a>
            <a href="/updates" class="mobile-link">Updates</a>
          </div>
          <a href="/#features" class="mobile-link">How it Works</a>
          <a href="/#pricing" class="mobile-link">Pricing</a>
          <a href="/blog/" class="mobile-link">Resources</a>
          <a href="/#faq" class="mobile-link">FAQ</a>
          <a href={checkoutUrl} class="download-btn" data-checkout-trigger data-checkout-location="editorial_mobile_nav_download">Download</a>
        </div>
      </div>
    </header>

    <div class="checkout-error" data-checkout-error hidden></div>

    <slot />

    <footer class="site-footer">
      <p>&copy; 2026 Focana. The desktop focus buddy for busy brains.</p>
      <div class="footer-links">
        <a href="/" class="footer-link">Home</a>
        <a href="/about" class="footer-link">About</a>
        <a href="/blog/" class="footer-link">Resources</a>
        <a href={checkoutUrl} class="footer-link" data-checkout-trigger data-checkout-location="editorial_footer_download">Download</a>
        <a href="/privacy" class="footer-link">Privacy</a>
        <a href="mailto:hello@focana.app" class="footer-link">Contact</a>
      </div>
    </footer>

    <Analytics />
    <SpeedInsights />

    <script define:vars={{ checkoutUrl }}>
      const CHECKOUT_URL = checkoutUrl;
      const productShell = document.querySelector('[data-product-shell]');
      const productToggle = document.querySelector('[data-product-toggle]');
      const productDropdown = document.querySelector('[data-product-dropdown]');
      const mobileToggle = document.querySelector('[data-mobile-toggle]');
      const mobileDrawer = document.querySelector('[data-mobile-drawer]');
      const mobileProductToggle = document.querySelector('[data-mobile-product-toggle]');
      const mobileProductLinks = document.querySelector('[data-mobile-product-links]');
      const mobileDrawerLinks = mobileDrawer?.querySelectorAll('a');
      const checkoutTriggers = document.querySelectorAll('[data-checkout-trigger]');
      const checkoutError = document.querySelector('[data-checkout-error]');
      let checkoutReadyPromise = null;
      let checkoutErrorTimeout = null;

      const setExpanded = (element, expanded) => {
        element?.setAttribute('aria-expanded', String(expanded));
      };

      const closeProductMenu = () => {
        if (!productDropdown || !productToggle) return;
        productDropdown.hidden = true;
        setExpanded(productToggle, false);
      };

      const toggleProductMenu = () => {
        if (!productDropdown || !productToggle) return;
        const nextOpen = productDropdown.hidden;
        productDropdown.hidden = !nextOpen;
        setExpanded(productToggle, nextOpen);
      };

      const closeMobileDrawer = () => {
        if (!mobileDrawer || !mobileToggle) return;
        mobileDrawer.hidden = true;
        setExpanded(mobileToggle, false);
        if (mobileProductLinks && mobileProductToggle) {
          mobileProductLinks.hidden = true;
          setExpanded(mobileProductToggle, false);
        }
      };

      const showCheckoutError = (message) => {
        if (!checkoutError) return;
        checkoutError.textContent = message;
        checkoutError.hidden = false;

        if (checkoutErrorTimeout) {
          window.clearTimeout(checkoutErrorTimeout);
        }

        checkoutErrorTimeout = window.setTimeout(() => {
          checkoutError.hidden = true;
          checkoutErrorTimeout = null;
        }, 5000);
      };

      const getCheckoutSuccessContext = (event) => {
        const payload = event?.data || {};
        const nestedOrder = payload.order || {};
        const attributes = payload.attributes || nestedOrder.attributes || {};

        const email =
          payload.user_email ||
          attributes.user_email ||
          nestedOrder.user_email ||
          '';

        const orderId =
          payload.id ||
          payload.order_id ||
          nestedOrder.id ||
          nestedOrder.order_id ||
          '';

        return {
          email: email ? String(email).trim() : '',
          orderId: orderId ? String(orderId).trim() : '',
        };
      };

      const setupLemon = () => {
        if (!window.LemonSqueezy || window.__focanaEditorialCheckoutSetup) return;

        window.__focanaEditorialCheckoutSetup = true;
        window.LemonSqueezy.Setup({
          eventHandler: (event) => {
            if (event.event !== 'Checkout.Success') return;

            const { email, orderId } = getCheckoutSuccessContext(event);

            try {
              window.sessionStorage.setItem(
                'focana_purchase_context',
                JSON.stringify({ email, orderId })
              );
            } catch {}

            const redirectUrl = new URL('/purchase-complete', window.location.origin);
            if (email) redirectUrl.searchParams.set('email', email);
            if (orderId) redirectUrl.searchParams.set('order_id', orderId);
            window.location.href = redirectUrl.toString();
          },
        });
      };

      const waitForCheckoutOverlay = () => {
        if (window.LemonSqueezy?.Url?.Open) {
          setupLemon();
          return Promise.resolve(window.LemonSqueezy);
        }

        if (checkoutReadyPromise) {
          return checkoutReadyPromise;
        }

        checkoutReadyPromise = new Promise((resolve, reject) => {
          let pollId = null;
          let timeoutId = null;

          const cleanup = () => {
            window.removeEventListener('lemon:ready', handleReady);
            if (pollId) window.clearInterval(pollId);
            if (timeoutId) window.clearTimeout(timeoutId);
            checkoutReadyPromise = null;
          };

          const finish = (callback) => {
            cleanup();
            callback();
          };

          const tryResolve = () => {
            if (!window.LemonSqueezy?.Url?.Open) return false;
            setupLemon();
            finish(() => resolve(window.LemonSqueezy));
            return true;
          };

          const handleReady = () => {
            tryResolve();
          };

          window.addEventListener('lemon:ready', handleReady);
          pollId = window.setInterval(() => {
            tryResolve();
          }, 100);
          timeoutId = window.setTimeout(() => {
            finish(() => reject(new Error('Lemon checkout overlay did not become available in time.')));
          }, 4000);

          tryResolve();
        });

        return checkoutReadyPromise;
      };

      const openCheckout = async () => {
        if (!/^https:\/\/focana\.lemonsqueezy\.com\//.test(CHECKOUT_URL)) {
          window.location.assign(CHECKOUT_URL);
          return;
        }

        try {
          const lemon = await waitForCheckoutOverlay();
          lemon.Url.Open(CHECKOUT_URL);
        } catch (error) {
          console.error('Failed to open Lemon overlay:', error);
          showCheckoutError('Checkout is still loading. Please try again.');
        }
      };

      productToggle?.addEventListener('click', (event) => {
        event.stopPropagation();
        toggleProductMenu();
      });

      document.addEventListener('click', (event) => {
        if (productShell && !productShell.contains(event.target)) {
          closeProductMenu();
        }
      });

      mobileToggle?.addEventListener('click', () => {
        if (!mobileDrawer || !mobileToggle) return;
        const nextOpen = mobileDrawer.hidden;
        mobileDrawer.hidden = !nextOpen;
        setExpanded(mobileToggle, nextOpen);
        closeProductMenu();
      });

      mobileProductToggle?.addEventListener('click', () => {
        if (!mobileProductLinks || !mobileProductToggle) return;
        const nextOpen = mobileProductLinks.hidden;
        mobileProductLinks.hidden = !nextOpen;
        setExpanded(mobileProductToggle, nextOpen);
      });

      mobileDrawerLinks?.forEach((link) => {
        link.addEventListener('click', closeMobileDrawer);
      });

      checkoutTriggers.forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          closeProductMenu();
          closeMobileDrawer();
          openCheckout();
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeProductMenu();
          closeMobileDrawer();
        }
      });
    </script>
  </body>
</html>
