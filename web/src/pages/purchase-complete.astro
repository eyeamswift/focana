---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import CheckoutBrandHeader from '../components/CheckoutBrandHeader.astro';
import { SITE_ORIGIN } from '../lib/siteOrigin';

const title = 'Focana - Purchase Complete';
const description = 'Use your Lemon Squeezy license key to activate Focana.';
const canonicalURL = `${SITE_ORIGIN}/purchase-complete`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_vZ4qnRVsao0nnscIJsBxC8LqOpPbNns5AE9ibSYhUdr', {
        api_host: 'https://us.i.posthog.com',
        defaults: '2026-01-30'
      })
    </script>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        background: linear-gradient(160deg, #FFFEF8 0%, #FFF9E6 50%, #FEF3C722 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .card {
        width: 100%;
        max-width: 660px;
        background: white;
        border-radius: 24px;
        padding: 42px 36px;
        box-shadow: 0 24px 80px rgba(92, 64, 51, 0.12);
      }
      h1 {
        font-family: 'Outfit', sans-serif;
        font-size: clamp(28px, 5vw, 36px);
        font-weight: 800;
        color: #5C4033;
        margin-bottom: 12px;
      }
      .subtitle {
        color: #8B6F47;
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 26px;
      }
      .steps {
        display: grid;
        gap: 14px;
        margin-bottom: 28px;
      }
      .step {
        border: 1px solid #E5D4B1;
        border-radius: 14px;
        padding: 16px;
        background: #FFFEF8;
      }
      .step strong {
        display: block;
        font-family: 'Outfit', sans-serif;
        color: #5C4033;
        font-size: 17px;
        margin-bottom: 6px;
      }
      .step p {
        color: #8B6F47;
        font-size: 14px;
        line-height: 1.6;
      }
      .actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 14px 22px;
        border-radius: 12px;
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 15px;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .btn:hover {
        transform: translateY(-2px);
      }
      .btn.primary {
        background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
        color: white;
        box-shadow: 0 4px 16px rgba(217, 119, 6, 0.25);
      }
      .btn.secondary {
        color: #5C4033;
        border: 1px solid #E5D4B1;
        background: #FFFEF8;
      }
      .support-note {
        color: #8B6F47;
        font-size: 13px;
        line-height: 1.6;
      }
      .support-note a {
        color: #D97706;
        font-weight: 700;
        text-decoration: none;
      }
      .support-note a:hover {
        text-decoration: underline;
      }
      @media (max-width: 520px) {
        .card { padding: 34px 22px; }
        .actions { flex-direction: column; }
        .btn { width: 100%; }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <CheckoutBrandHeader subtitle="Your Focana purchase is complete." />
      <h1>Activate Focana with your license key.</h1>
      <p class="subtitle">
        Lemon Squeezy will email your receipt and license key. If Focana is already installed,
        open the app and paste that key when it asks you to activate.
      </p>

      <div class="steps" aria-label="Activation steps">
        <div class="step">
          <strong>1. Check your Lemon receipt</strong>
          <p>The license key is included in the receipt email. It may take a minute to arrive.</p>
        </div>
        <div class="step">
          <strong>2. Open Focana</strong>
          <p>If your trial has ended, choose "I already have a license key" and paste the key.</p>
        </div>
        <div class="step">
          <strong>3. Keep focusing</strong>
          <p>Monthly and lifetime purchases both unlock the same app experience.</p>
        </div>
      </div>

      <div class="actions">
        <a href="/download" class="btn primary">Download Focana</a>
        <a href="mailto:hello@focana.app" class="btn secondary">Contact support</a>
      </div>

      <p class="support-note">
        Already installed but the key is not working? Email <a href="mailto:hello@focana.app">hello@focana.app</a>
        with the purchase email from your Lemon receipt.
      </p>
    </div>

    <Analytics />
    <SpeedInsights />

    <script>
      if (window.posthog) {
        window.posthog.capture('purchase_complete_viewed');
      }
    </script>
  </body>
</html>
