---
const title = "Download Focana — Thank You!";
const description = "Download Focana for macOS. Choose Apple Silicon or Intel.";
const canonicalURL = "https://focana.app/download";

const ARM_URL = "https://github.com/eyeamswift/focana/releases/download/v1.2.0-beta.3/Focana-1.2.0-beta.3-mac-arm64.dmg";
const INTEL_URL = "https://github.com/eyeamswift/focana/releases/download/v1.2.0-beta.3/Focana-1.2.0-beta.3-mac-x64.dmg";

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- PostHog Analytics -->
    <script>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_vZ4qnRVsao0nnscIJsBxC8LqOpPbNns5AE9ibSYhUdr', {
          api_host: 'https://us.i.posthog.com',
          defaults: '2026-01-30'
      })
    </script>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        background: linear-gradient(160deg, #FFFEF8 0%, #FFF9E6 50%, #FEF3C722 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 24px 48px;
      }
      .download-card {
        background: white;
        border-radius: 24px;
        padding: 48px 40px;
        max-width: 520px;
        width: 100%;
        box-shadow: 0 24px 80px rgba(92, 64, 51, 0.12);
        text-align: center;
      }
      .download-card h1 {
        font-family: 'Outfit', sans-serif;
        font-size: 28px;
        font-weight: 800;
        color: #5C4033;
        margin-bottom: 8px;
      }
      .download-card .subtitle {
        font-size: 16px;
        color: #8B6F47;
        margin-bottom: 32px;
        line-height: 1.5;
      }
      .download-buttons {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
      }
      .download-btn {
        flex: 1;
        min-width: 180px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 16px 24px;
        border-radius: 12px;
        font-family: 'DM Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: none;
      }
      .download-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(217, 119, 6, 0.3);
      }
      .download-btn.primary {
        background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
        color: white;
        box-shadow: 0 4px 16px rgba(217, 119, 6, 0.25);
      }
      .download-btn.secondary {
        background: #FEF3C7;
        color: #5C4033;
        border: 2px solid #E5D4B1;
      }
      .recommended-label {
        display: none;
        font-size: 13px;
        font-weight: 600;
        color: #5C4033;
        margin-bottom: 8px;
        text-align: left;
      }
      .recommended-label.visible {
        display: block;
      }
      .chip-help {
        font-size: 12px;
        color: #7A6548;
        line-height: 1.7;
        margin-bottom: 20px;
        text-align: left;
      }
      .chip-help strong {
        color: #8B6F47;
      }
      .not-sure-box {
        background: #F5F5F5;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 24px;
        text-align: left;
        font-size: 12px;
        color: #7A6548;
        line-height: 1.5;
      }
      .back-link {
        display: inline-block;
        font-size: 14px;
        color: #D97706;
        text-decoration: none;
        font-weight: 600;
      }
      .back-link:hover {
        text-decoration: underline;
      }
      .info-tooltip {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: help;
      }
      .info-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #E5D4B1;
        color: #5C4033;
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
        flex-shrink: 0;
        vertical-align: middle;
      }
      .info-tooltip .tooltip-img {
        display: none;
        position: absolute;
        bottom: calc(100% + 10px);
        left: 50%;
        transform: translateX(-50%);
        background: white;
        border-radius: 12px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.18);
        padding: 8px;
        z-index: 10;
        width: 280px;
      }
      .info-tooltip .tooltip-img img {
        width: 100%;
        border-radius: 8px;
        display: block;
      }
      .info-tooltip:hover .tooltip-img,
      .info-tooltip:focus-within .tooltip-img {
        display: block;
      }
      /* Survey section */
      .page-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        width: 100%;
        max-width: 520px;
      }
      .survey-section {
        display: none;
        opacity: 0;
        background: white;
        border-radius: 24px;
        padding: 40px;
        width: 100%;
        box-shadow: 0 24px 80px rgba(92, 64, 51, 0.12);
        text-align: left;
        transition: opacity 0.4s ease;
      }
      .survey-section.visible {
        display: block;
      }
      .survey-section.fade-in {
        opacity: 1;
      }
      .survey-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 28px;
      }
      .survey-header h2 {
        font-family: 'Outfit', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #5C4033;
        line-height: 1.4;
        flex: 1;
        margin-right: 16px;
      }
      .skip-link {
        font-size: 14px;
        font-weight: 600;
        color: #8B6F47;
        cursor: pointer;
        background: none;
        border: none;
        font-family: 'DM Sans', sans-serif;
        white-space: nowrap;
        padding: 4px 0;
        flex-shrink: 0;
      }
      .skip-link:hover {
        color: #D97706;
        text-decoration: underline;
      }
      .survey-question {
        margin-bottom: 24px;
      }
      .survey-question:last-of-type {
        margin-bottom: 28px;
      }
      .survey-question label.question-label {
        display: block;
        font-family: 'Outfit', sans-serif;
        font-size: 15px;
        font-weight: 600;
        color: #5C4033;
        margin-bottom: 12px;
      }
      .survey-options {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .survey-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 10px;
        border: 1.5px solid #E5D4B1;
        background: #FFFEF8;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease;
        font-size: 14px;
        color: #5C4033;
        line-height: 1.4;
      }
      .survey-option:hover {
        border-color: #D97706;
        background: #FFF9E6;
      }
      .survey-option input[type="radio"],
      .survey-option input[type="checkbox"] {
        accent-color: #F59E0B;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        cursor: pointer;
      }
      .survey-option span {
        cursor: pointer;
      }
      .survey-submit {
        width: 100%;
        padding: 14px 24px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
        color: white;
        font-family: 'DM Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 4px 16px rgba(217, 119, 6, 0.25);
      }
      .survey-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(217, 119, 6, 0.3);
      }
      .survey-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
      }
      .survey-thanks {
        display: none;
        text-align: center;
        padding: 20px 0 4px;
      }
      .survey-thanks.visible {
        display: block;
      }
      .survey-thanks p {
        font-size: 16px;
        font-weight: 600;
        color: #5C4033;
        line-height: 1.5;
      }
      @media (max-width: 480px) {
        .download-card { padding: 32px 24px; }
        .download-card h1 { font-size: 24px; }
        .download-buttons { flex-direction: column; }
        .download-btn { min-width: unset; }
        .survey-section { padding: 28px 20px; }
        .survey-header h2 { font-size: 18px; }
      }
    </style>
  </head>
  <body>
    <div class="page-wrapper">
      <div class="download-card">
        <h1>Thank you for your purchase!</h1>
        <p class="subtitle">
          You're in. Download Focana and start your first session in seconds.
        </p>

        <p class="recommended-label" id="recommended-label">Recommended for your Mac</p>
        <div class="download-buttons" id="download-buttons">
          <a href={ARM_URL} class="download-btn primary" id="arm-btn">
            Apple Silicon (M1–M4)
          </a>
          <a href={INTEL_URL} class="download-btn secondary" id="intel-btn">
            Intel Mac
          </a>
        </div>

        <p class="chip-help">
          <strong>Apple Silicon (M1–M4):</strong> MacBook Air/Pro 2020+, iMac 2021+, Mac Mini 2020+<br />
          <strong>Intel:</strong> MacBook Air/Pro 2019 and earlier, iMac 2020 and earlier
        </p>

        <div class="not-sure-box">
          <span class="info-tooltip">
            Not sure which to pick? Click the  icon in the top left of your screen and select "About This Mac."
            <span class="info-icon" tabindex="0" aria-label="Show helper image">?</span>
            <span class="tooltip-img"><img src="/download-help.png" alt="Screenshot showing Apple menu with About This Mac highlighted" /></span>
          </span>
        </div>

        <a href="/" class="back-link">&larr; Back to focana.app</a>
      </div>

      <div class="survey-section" id="survey-section">
        <div class="survey-header">
          <h2>While Focana downloads — help us with 3 quick questions</h2>
          <button class="skip-link" id="survey-skip">Skip</button>
        </div>

        <form id="survey-form">
          <div class="survey-question">
            <label class="question-label">1. How'd you find Focana?</label>
            <div class="survey-options">
              <label class="survey-option"><input type="radio" name="how_found" value="Reddit" /><span>Reddit</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Twitter / X" /><span>Twitter / X</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="TikTok" /><span>TikTok</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="YouTube" /><span>YouTube</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="A friend or coworker" /><span>A friend or coworker</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="An ADHD creator or coach" /><span>An ADHD creator or coach</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Product Hunt" /><span>Product Hunt</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Google search" /><span>Google search</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Blog or article" /><span>Blog or article</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Other" /><span>Other</span></label>
            </div>
          </div>

          <div class="survey-question">
            <label class="question-label">2. What's your biggest focus struggle?</label>
            <div class="survey-options">
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I can't start tasks even when I know what to do" /><span>I can't start tasks even when I know what to do</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I lose track of what I'm working on when I switch apps" /><span>I lose track of what I'm working on when I switch apps</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I don't notice time passing until it's too late" /><span>I don't notice time passing until it's too late</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="Random thoughts pull me off track constantly" /><span>Random thoughts pull me off track constantly</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I've tried other tools and nothing sticks" /><span>I've tried other tools and nothing sticks</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I forget where I left off between work sessions" /><span>I forget where I left off between work sessions</span></label>
            </div>
          </div>

          <div class="survey-question">
            <label class="question-label">3. What have you tried before?</label>
            <div class="survey-options">
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Phone timers or alarms" /><span>Phone timers or alarms</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Pomodoro apps (Forest, Focus Keeper, etc.)" /><span>Pomodoro apps (Forest, Focus Keeper, etc.)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Notion / Todoist / task managers" /><span>Notion / Todoist / task managers</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Focus music (Brain.fm, Endel, lo-fi)" /><span>Focus music (Brain.fm, Endel, lo-fi)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Website blockers (Cold Turkey, Freedom)" /><span>Website blockers (Cold Turkey, Freedom)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Body doubling (Focusmate, co-working streams)" /><span>Body doubling (Focusmate, co-working streams)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Sticky notes (physical or digital)" /><span>Sticky notes (physical or digital)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Nothing — this is my first try" /><span>Nothing — this is my first try</span></label>
            </div>
          </div>

          <button type="submit" class="survey-submit" id="survey-submit">Send &amp; start focusing</button>
        </form>

        <div class="survey-thanks" id="survey-thanks">
          <p>Thanks! Now go open Focana and start your first session.</p>
        </div>
      </div>
    </div>

    <script>
      (function() {
        // Read query params client-side (page is statically built)
        var urlParams = new URLSearchParams(window.location.search);
        var customerEmail = urlParams.get('email') || '';
        var orderId = urlParams.get('order_id') || '';

        function getIsAppleSilicon() {
          try {
            if (!/Mac/.test(navigator.userAgent)) return null;
            if (/ARM/.test(navigator.userAgent)) return true;
            if (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1) return true;
            var canvas = document.createElement("canvas");
            var gl = canvas.getContext("webgl2") || canvas.getContext("webgl");
            if (gl) {
              var dbg = gl.getExtension("WEBGL_debug_renderer_info");
              if (dbg) {
                var renderer = gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL);
                if (/Apple/.test(renderer) && !/Intel/.test(renderer)) return true;
                if (/Intel/.test(renderer)) return false;
              }
            }
          } catch(e) {}
          return null;
        }

        var isArm = getIsAppleSilicon();
        var armBtn = document.getElementById('arm-btn');
        var intelBtn = document.getElementById('intel-btn');
        var label = document.getElementById('recommended-label');

        function phCapture(event, props) {
          if (window.posthog) window.posthog.capture(event, props);
        }

        // Track download page view
        phCapture("download_page_viewed", {
          chip_detected: isArm === true ? "apple_silicon" : isArm === false ? "intel" : "unknown",
          email: customerEmail,
          order_id: orderId
        });

        if (isArm === true) {
          label.classList.add('visible');
          intelBtn.classList.remove('primary');
          intelBtn.classList.add('secondary');
          armBtn.classList.remove('secondary');
          armBtn.classList.add('primary');
        } else if (isArm === false) {
          label.classList.add('visible');
          armBtn.classList.remove('primary');
          armBtn.classList.add('secondary');
          intelBtn.classList.remove('secondary');
          intelBtn.classList.add('primary');
        }

        // Survey elements
        var surveySection = document.getElementById('survey-section');
        var surveyForm = document.getElementById('survey-form');
        var surveySkip = document.getElementById('survey-skip');
        var surveyThanks = document.getElementById('survey-thanks');
        var surveySubmitBtn = document.getElementById('survey-submit');
        var surveyShown = false;

        function showSurvey() {
          if (surveyShown) return;
          surveyShown = true;
          surveySection.classList.add('visible');
          // Trigger reflow then fade in
          surveySection.offsetHeight;
          surveySection.classList.add('fade-in');
          // Scroll to survey smoothly
          setTimeout(function() {
            surveySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 100);
        }

        function showThanks() {
          surveyForm.style.display = 'none';
          document.querySelector('.survey-header').style.display = 'none';
          surveyThanks.classList.add('visible');
        }

        // Track download clicks & show survey
        armBtn.addEventListener('click', function() {
          phCapture("dmg_downloaded", { chip: "apple_silicon", email: customerEmail, order_id: orderId });
          showSurvey();
        });
        intelBtn.addEventListener('click', function() {
          phCapture("dmg_downloaded", { chip: "intel", email: customerEmail, order_id: orderId });
          showSurvey();
        });

        // Skip survey
        surveySkip.addEventListener('click', function() {
          phCapture("survey_skipped", { email: customerEmail, order_id: orderId });
          showThanks();
        });

        // Submit survey
        surveyForm.addEventListener('submit', function(e) {
          e.preventDefault();
          surveySubmitBtn.disabled = true;
          surveySubmitBtn.textContent = 'Sending...';

          // Gather responses
          var howFoundEl = surveyForm.querySelector('input[name="how_found"]:checked');
          var howFound = howFoundEl ? howFoundEl.value : null;

          var focusStruggles = [];
          surveyForm.querySelectorAll('input[name="focus_struggles"]:checked').forEach(function(cb) {
            focusStruggles.push(cb.value);
          });

          var toolsTried = [];
          surveyForm.querySelectorAll('input[name="tools_tried"]:checked').forEach(function(cb) {
            toolsTried.push(cb.value);
          });

          // Fire PostHog event
          phCapture("survey_completed", {
            email: customerEmail,
            order_id: orderId,
            how_found: howFound,
            focus_struggles: focusStruggles,
            tools_tried: toolsTried
          });

          // Save survey answers via server-side API
          if (customerEmail || orderId) {
            fetch('/api/survey', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: customerEmail,
                order_id: orderId,
                how_found: howFound,
                focus_struggles: focusStruggles,
                tools_tried: toolsTried
              })
            }).then(function(res) {
              if (!res.ok) {
                return res.text().then(function(text) {
                  throw new Error(text || ('Request failed with status ' + res.status));
                });
              }

              showThanks();
            }).catch(function(err) {
              console.error('Survey submit failed:', err);
              surveySubmitBtn.disabled = false;
              surveySubmitBtn.textContent = 'Try sending again';
            });
            return;
          }

          showThanks();
        });
      })();
    </script>
  </body>
</html>
