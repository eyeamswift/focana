---
const title = "Download Focana — Thank You!";
const description = "Download Focana for macOS. Choose Apple Silicon or Intel.";
const canonicalURL = "https://focana.app/download";

const ARM_URL = "https://github.com/eyeamswift/focana/releases/download/v1.2.0-beta.3/Focana-1.2.0-beta.3-mac-arm64.dmg";
const INTEL_URL = "https://github.com/eyeamswift/focana/releases/download/v1.2.0-beta.3/Focana-1.2.0-beta.3-mac-x64.dmg";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- PostHog Analytics -->
    <script>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_vZ4qnRVsao0nnscIJsBxC8LqOpPbNns5AE9ibSYhUdr', {
          api_host: 'https://us.i.posthog.com',
          defaults: '2026-01-30'
      })
    </script>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        background: linear-gradient(160deg, #FFFEF8 0%, #FFF9E6 50%, #FEF3C722 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .download-card {
        background: white;
        border-radius: 24px;
        padding: 48px 40px;
        max-width: 520px;
        width: 100%;
        box-shadow: 0 24px 80px rgba(92, 64, 51, 0.12);
        text-align: center;
      }
      .download-card h1 {
        font-family: 'Outfit', sans-serif;
        font-size: 28px;
        font-weight: 800;
        color: #5C4033;
        margin-bottom: 8px;
      }
      .download-card .subtitle {
        font-size: 16px;
        color: #8B6F47;
        margin-bottom: 32px;
        line-height: 1.5;
      }
      .download-buttons {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
      }
      .download-btn {
        flex: 1;
        min-width: 180px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 16px 24px;
        border-radius: 12px;
        font-family: 'DM Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: none;
      }
      .download-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(217, 119, 6, 0.3);
      }
      .download-btn.primary {
        background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
        color: white;
        box-shadow: 0 4px 16px rgba(217, 119, 6, 0.25);
      }
      .download-btn.secondary {
        background: #FEF3C7;
        color: #5C4033;
        border: 2px solid #E5D4B1;
      }
      .recommended-label {
        display: none;
        font-size: 13px;
        font-weight: 600;
        color: #5C4033;
        margin-bottom: 8px;
        text-align: left;
      }
      .recommended-label.visible {
        display: block;
      }
      .chip-help {
        font-size: 12px;
        color: #7A6548;
        line-height: 1.7;
        margin-bottom: 20px;
        text-align: left;
      }
      .chip-help strong {
        color: #8B6F47;
      }
      .not-sure-box {
        background: #F5F5F5;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 24px;
        text-align: left;
        font-size: 12px;
        color: #7A6548;
        line-height: 1.5;
      }
      .back-link {
        display: inline-block;
        font-size: 14px;
        color: #D97706;
        text-decoration: none;
        font-weight: 600;
      }
      .back-link:hover {
        text-decoration: underline;
      }
      .info-tooltip {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: help;
      }
      .info-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #E5D4B1;
        color: #5C4033;
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
        flex-shrink: 0;
        vertical-align: middle;
      }
      .info-tooltip .tooltip-img {
        display: none;
        position: absolute;
        bottom: calc(100% + 10px);
        left: 50%;
        transform: translateX(-50%);
        background: white;
        border-radius: 12px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.18);
        padding: 8px;
        z-index: 10;
        width: 280px;
      }
      .info-tooltip .tooltip-img img {
        width: 100%;
        border-radius: 8px;
        display: block;
      }
      .info-tooltip:hover .tooltip-img,
      .info-tooltip:focus-within .tooltip-img {
        display: block;
      }
      @media (max-width: 480px) {
        .download-card { padding: 32px 24px; }
        .download-card h1 { font-size: 24px; }
        .download-buttons { flex-direction: column; }
        .download-btn { min-width: unset; }
      }
    </style>
  </head>
  <body>
    <div class="download-card">
      <h1>Thank you for your purchase!</h1>
      <p class="subtitle">
        You're in. Download Focana and start your first session in seconds.
      </p>

      <p class="recommended-label" id="recommended-label">Recommended for your Mac</p>
      <div class="download-buttons" id="download-buttons">
        <a href={ARM_URL} class="download-btn primary" id="arm-btn">
          Apple Silicon (M1–M4)
        </a>
        <a href={INTEL_URL} class="download-btn secondary" id="intel-btn">
          Intel Mac
        </a>
      </div>

      <p class="chip-help">
        <strong>Apple Silicon (M1–M4):</strong> MacBook Air/Pro 2020+, iMac 2021+, Mac Mini 2020+<br />
        <strong>Intel:</strong> MacBook Air/Pro 2019 and earlier, iMac 2020 and earlier
      </p>

      <div class="not-sure-box">
        <span class="info-tooltip">
          Not sure which to pick? Click the  icon in the top left of your screen and select "About This Mac."
          <span class="info-icon" tabindex="0" aria-label="Show helper image">?</span>
          <span class="tooltip-img"><img src="/download-help.png" alt="Screenshot showing Apple menu with About This Mac highlighted" /></span>
        </span>
      </div>

      <a href="/" class="back-link">&larr; Back to focana.app</a>
    </div>

    <script>
      (function() {
        function getIsAppleSilicon() {
          try {
            if (!/Mac/.test(navigator.userAgent)) return null;
            // Check UA for ARM
            if (/ARM/.test(navigator.userAgent)) return true;
            // iPad-as-Mac detection
            if (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1) return true;
            // WebGL renderer — Apple GPU = Apple Silicon, Intel = Intel Mac
            const canvas = document.createElement("canvas");
            const gl = canvas.getContext("webgl2") || canvas.getContext("webgl");
            if (gl) {
              const dbg = gl.getExtension("WEBGL_debug_renderer_info");
              if (dbg) {
                const renderer = gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL);
                if (/Apple/.test(renderer) && !/Intel/.test(renderer)) return true;
                if (/Intel/.test(renderer)) return false;
              }
            }
          } catch {}
          return null;
        }

        const isArm = getIsAppleSilicon();
        const armBtn = document.getElementById('arm-btn');
        const intelBtn = document.getElementById('intel-btn');
        const label = document.getElementById('recommended-label');

        function phCapture(event, props) {
          if (window.posthog) window.posthog.capture(event, props);
        }

        // Track download page view
        phCapture("download_page_viewed", { chip_detected: isArm === true ? "apple_silicon" : isArm === false ? "intel" : "unknown" });

        if (isArm === true) {
          label.classList.add('visible');
          intelBtn.classList.remove('primary');
          intelBtn.classList.add('secondary');
          armBtn.classList.remove('secondary');
          armBtn.classList.add('primary');
        } else if (isArm === false) {
          label.classList.add('visible');
          armBtn.classList.remove('primary');
          armBtn.classList.add('secondary');
          intelBtn.classList.remove('secondary');
          intelBtn.classList.add('primary');
        }

        // Track download clicks
        armBtn.addEventListener('click', function() {
          phCapture("dmg_downloaded", { chip: "apple_silicon" });
        });
        intelBtn.addEventListener('click', function() {
          phCapture("dmg_downloaded", { chip: "intel" });
        });
      })();
    </script>
  </body>
</html>
