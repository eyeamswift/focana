---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { firstBlogPost, siteAuthor } from '../../data/blog';
import { SITE_ORIGIN } from '../../lib/siteOrigin';

const post = firstBlogPost;
const title = 'Out of Sight, Out of Mind: Why ADHD Brains Need Visible Tools';
const canonicalURL = `${SITE_ORIGIN}/blog/${post.slug}`;
const publishedDateTime = '2026-04-14T09:00:00-05:00';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Focana',
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'macOS',
  description:
    'A floating focus app for macOS that keeps your task and timer visible while you work across apps.',
  url: SITE_ORIGIN,
  offers: {
    '@type': 'Offer',
    price: '29',
    priceCurrency: 'USD',
    availability: 'https://schema.org/OnlineOnly',
  },
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteAuthor.name,
  sameAs: siteAuthor.sameAs,
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  datePublished: publishedDateTime,
  dateModified: publishedDateTime,
  mainEntityOfPage: canonicalURL,
  image: `${SITE_ORIGIN}/og-image.png`,
  author: {
    '@type': 'Person',
    name: siteAuthor.name,
    sameAs: siteAuthor.sameAs,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Focana',
    url: SITE_ORIGIN,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_ORIGIN}/favicon.png`,
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE_ORIGIN,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Resources',
      item: `${SITE_ORIGIN}/blog`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.title,
      item: canonicalURL,
    },
  ],
};
---

<EditorialLayout
  title={title}
  description={post.description}
  canonicalURL={canonicalURL}
  ogType="article"
  ogImageAlt={post.ogImageAlt}
  jsonLd={[faqSchema, softwareSchema, personSchema, articleSchema, breadcrumbSchema]}
>
  <Fragment slot="head">
    <meta name="author" content={siteAuthor.name} />
    <meta property="article:published_time" content={publishedDateTime} />
    <meta property="article:modified_time" content={publishedDateTime} />
    <meta property="article:section" content="ADHD Focus" />
    {post.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <main class="article-page">
    <div class="article-shell">
      <article class="article-card">
        <header class="article-header">
          <a href="/blog/" class="back-link">Resources</a>
          <span class="eyebrow">ADHD Focus</span>
          <h1>{post.title}</h1>
          <p class="article-dek">{post.description}</p>

          <div class="byline-row">
            <div class="author-block">
              <span class="author-name">{siteAuthor.name}</span>
              <span class="author-role">{siteAuthor.role}</span>
            </div>
            <time class="publish-date" datetime={post.publishedDate}>{post.publishedLabel}</time>
          </div>
        </header>

        <div class="summary-box">
          <p class="summary-label">Bottom line</p>
          <p>
            If the task disappears from view, ADHD attention has a much harder time keeping it
            active. Visible focus tools work because they externalize working memory instead of
            asking your brain to carry everything alone.
          </p>
        </div>

        <div class="article-body">
          {post.opening.map((paragraph) => (
            <p>{paragraph}</p>
          ))}

          <ul>
            {post.examples.map((example) => (
              <li>{example}</li>
            ))}
          </ul>

          {post.sections.map((section) => (
            <section class="article-section">
              <h2>{section.title}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
            </section>
          ))}

          {post.closing.map((paragraph) => (
            <p>{paragraph}</p>
          ))}

          <section class="faq-section" id="faq">
            <h2>Frequently Asked Questions</h2>
            <div class="faq-list">
              {post.faqs.map((faq) => (
                <details class="faq-item">
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        </div>

        <footer class="article-footer">
          <div class="author-note">
            <p class="author-note-label">Written by</p>
            <p>
              {siteAuthor.name}, {siteAuthor.role}. {siteAuthor.note}
            </p>
          </div>

          <div class="cta-card">
            <p class="cta-label">Need a visible focus anchor?</p>
            <p>
              Focana keeps your current task and timer floating above every window so your work
              stays in sight while you switch between apps.
            </p>
            <a href="/download" class="cta-link">See Focana</a>
          </div>
        </footer>
      </article>
    </div>
  </main>

  <style>
    .article-page {
      padding: 56px 0 96px;
    }

    .article-shell {
      width: min(1180px, calc(100% - 48px));
      margin: 0 auto;
    }

    .article-card {
      width: min(860px, 100%);
      margin: 0 auto;
      padding: 42px 46px 48px;
      border: 1px solid var(--line);
      border-radius: 32px;
      background: var(--bg-panel);
      box-shadow: var(--shadow);
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--muted-soft);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .back-link::before {
      content: '←';
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      margin-top: 20px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255, 249, 230, 0.92);
      border: 1px solid rgba(229, 212, 177, 0.84);
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .article-header h1 {
      margin-top: 20px;
      font-family: 'Outfit', sans-serif;
      font-size: clamp(38px, 6vw, 64px);
      line-height: 1.04;
      letter-spacing: -0.05em;
    }

    .article-dek {
      margin-top: 20px;
      font-size: clamp(18px, 2.2vw, 22px);
      line-height: 1.8;
      color: var(--muted);
    }

    .byline-row {
      margin-top: 26px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
      padding-top: 22px;
      border-top: 1px solid rgba(229, 212, 177, 0.8);
    }

    .author-block {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .author-name {
      font-weight: 700;
      color: var(--text);
    }

    .author-role,
    .publish-date {
      color: var(--muted-soft);
    }

    .summary-box {
      margin-top: 30px;
      padding: 22px 24px;
      border-radius: 22px;
      border: 1px solid rgba(229, 212, 177, 0.88);
      background:
        linear-gradient(135deg, rgba(252, 211, 77, 0.14), rgba(255, 249, 230, 0.82)),
        rgba(255, 255, 255, 0.86);
    }

    .summary-label,
    .author-note-label,
    .cta-label {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted-soft);
    }

    .summary-box p + p {
      margin-top: 10px;
      font-size: 17px;
      line-height: 1.8;
      color: var(--text);
    }

    .article-body {
      margin-top: 34px;
      font-size: 19px;
      line-height: 1.9;
      color: var(--text);
    }

    .article-body p + p,
    .article-section,
    .faq-section {
      margin-top: 26px;
    }

    .article-body h2 {
      margin-bottom: 16px;
      font-family: 'Outfit', sans-serif;
      font-size: clamp(28px, 4vw, 36px);
      line-height: 1.1;
      letter-spacing: -0.04em;
    }

    .article-body ul {
      margin-top: 18px;
      padding-left: 24px;
      display: grid;
      gap: 12px;
      color: var(--muted);
    }

    .article-body li::marker {
      color: var(--accent);
    }

    .faq-list {
      margin-top: 18px;
      display: grid;
      gap: 14px;
    }

    .faq-item {
      padding: 18px 20px;
      border-radius: 18px;
      border: 1px solid rgba(229, 212, 177, 0.84);
      background: rgba(255, 255, 255, 0.72);
    }

    .faq-item summary {
      list-style: none;
      cursor: pointer;
      font-family: 'Outfit', sans-serif;
      font-size: 22px;
      font-weight: 600;
      line-height: 1.35;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item p {
      margin-top: 12px;
      font-size: 17px;
      line-height: 1.8;
      color: var(--muted);
    }

    .article-footer {
      margin-top: 42px;
      display: grid;
      gap: 18px;
    }

    .author-note,
    .cta-card {
      padding: 22px 24px;
      border-radius: 22px;
      border: 1px solid rgba(229, 212, 177, 0.88);
      background: rgba(255, 255, 255, 0.78);
    }

    .author-note p + p,
    .cta-card p + p {
      margin-top: 10px;
      line-height: 1.8;
      color: var(--muted);
    }

    .cta-link {
      margin-top: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 20px;
      border-radius: 14px;
      text-decoration: none;
      font-weight: 700;
      color: #fff;
      background: linear-gradient(135deg, var(--accent), var(--accent-deep));
      box-shadow: 0 14px 34px rgba(217, 119, 6, 0.24);
    }

    @media (max-width: 720px) {
      .article-page {
        padding-top: 40px;
        padding-bottom: 72px;
      }

      .article-shell {
        width: min(100% - 32px, 1180px);
      }

      .article-card {
        padding: 28px 22px 32px;
        border-radius: 26px;
      }

      .article-body {
        font-size: 18px;
      }

      .faq-item summary {
        font-size: 20px;
      }
    }
  </style>
</EditorialLayout>
