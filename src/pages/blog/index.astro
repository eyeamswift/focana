---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { blogPosts } from '../../data/blog';
import { SITE_ORIGIN } from '../../lib/siteOrigin';

const title = 'Resources | Focana';
const description =
  'Articles and practical guides about ADHD focus, visible working memory, app switching, and staying anchored while you work.';
const canonicalURL = `${SITE_ORIGIN}/blog`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Focana Resources',
  description,
  url: canonicalURL,
  publisher: {
    '@type': 'Organization',
    name: 'Focana',
    url: SITE_ORIGIN,
  },
  blogPost: blogPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    url: `${SITE_ORIGIN}/blog/${post.slug}`,
    datePublished: post.publishedDate,
  })),
};
---

<EditorialLayout title={title} description={description} canonicalURL={canonicalURL} jsonLd={jsonLd}>
  <main class="resources-page">
    <section class="resources-hero">
      <span class="eyebrow">Resources</span>
      <h1>Practical guides on visible focus, app switching, and ADHD-friendly work.</h1>
      <p>
        This is the Focana resource library. Right now it starts with one flagship article on
        visible focus and working memory, with more human-written guides to follow as the library
        grows.
      </p>
    </section>

    <section class="resources-grid">
      {blogPosts.map((post, index) => (
        <article class="article-card">
          <div class="card-topline">
            <span class:list={['card-pill', index === 0 && 'card-pill--primary']}>
              {index === 0 ? 'Start here' : index === 1 ? 'Next read' : 'Then read'}
            </span>
            <time datetime={post.publishedDate}>{post.publishedLabel}</time>
          </div>

          <h2>
            <a href={`/blog/${post.slug}`} class="article-link">{post.title}</a>
          </h2>

          <p class="article-excerpt">{post.excerpt}</p>

          <div class="tag-row">
            {post.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>

          <a href={`/blog/${post.slug}`} class="read-link">
            Read article
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </section>

    <section class="cluster-card">
      <div class="cluster-copy">
        <span class="cluster-label">Start here</span>
        <h2>Begin with the flagship article</h2>
        <p>
          If you want the best starting point for how Focana thinks about attention, begin with why
          ADHD brains lose the thread when a task leaves the screen. Future guides will build on
          that foundation.
        </p>
      </div>

      <div class="cluster-steps">
        {blogPosts.map((post, index) => (
          <a href={`/blog/${post.slug}`} class="cluster-step">
            <span class="cluster-step-number">{index + 1}</span>
            <div>
              <strong>{post.title}</strong>
              <span>{post.excerpt}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="cluster-footer">
        <p>Want to see the product behind these ideas?</p>
        <a href="/" class="cluster-link">Explore Focana</a>
      </div>
    </section>
  </main>

  <style>
    .resources-page {
      width: min(1180px, calc(100% - 48px));
      margin: 0 auto;
      padding: 72px 0 96px;
    }

    .resources-hero {
      width: min(760px, 100%);
      padding: 24px 0 54px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(229, 212, 177, 0.84);
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .resources-hero h1 {
      margin-top: 20px;
      font-family: 'Outfit', sans-serif;
      font-size: clamp(42px, 7vw, 72px);
      line-height: 1.04;
      letter-spacing: -0.05em;
    }

    .resources-hero p {
      margin-top: 18px;
      font-size: clamp(17px, 2vw, 20px);
      line-height: 1.8;
      color: var(--muted);
    }

    .resources-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
    }

    .cluster-card {
      margin-top: 28px;
      padding: 30px;
      border: 1px solid var(--line);
      border-radius: 28px;
      background: var(--bg-panel);
      box-shadow: var(--shadow);
    }

    .cluster-copy {
      max-width: 760px;
    }

    .cluster-label {
      display: inline-flex;
      align-items: center;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(229, 212, 177, 0.84);
      color: var(--muted);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .cluster-card h2 {
      margin-top: 18px;
      font-family: 'Outfit', sans-serif;
      font-size: clamp(30px, 4vw, 44px);
      line-height: 1.08;
      letter-spacing: -0.04em;
    }

    .cluster-card p,
    .cluster-step span {
      margin-top: 16px;
      font-size: 17px;
      line-height: 1.75;
      color: var(--muted);
    }

    .cluster-steps {
      margin-top: 24px;
      display: grid;
      gap: 16px;
    }

    .cluster-step {
      display: grid;
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 16px;
      align-items: start;
      padding: 18px 20px;
      border-radius: 20px;
      border: 1px solid rgba(229, 212, 177, 0.84);
      background: rgba(255, 249, 230, 0.52);
      text-decoration: none;
    }

    .cluster-step-number {
      width: 40px;
      height: 40px;
      margin-top: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--accent), var(--accent-deep));
      color: #fff;
      font-weight: 700;
    }

    .cluster-step strong {
      display: block;
      color: var(--text);
      font-size: 20px;
      line-height: 1.3;
      font-family: 'Outfit', sans-serif;
    }

    .cluster-footer {
      margin-top: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .cluster-footer p {
      margin-top: 0;
    }

    .cluster-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 20px;
      border-radius: 14px;
      text-decoration: none;
      font-weight: 700;
      color: #fff;
      background: linear-gradient(135deg, var(--accent), var(--accent-deep));
      box-shadow: 0 14px 34px rgba(217, 119, 6, 0.24);
    }

    .article-card {
      padding: 28px;
      border: 1px solid var(--line);
      border-radius: 28px;
      background: var(--bg-panel);
      box-shadow: var(--shadow);
    }

    .card-topline {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      color: var(--muted-soft);
      font-size: 14px;
    }

    .card-pill {
      display: inline-flex;
      align-items: center;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(255, 249, 230, 0.92);
      border: 1px solid rgba(229, 212, 177, 0.84);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .card-pill--primary {
      color: var(--text);
      background: rgba(252, 211, 77, 0.18);
    }

    .article-card h2 {
      margin-top: 20px;
      font-family: 'Outfit', sans-serif;
      font-size: clamp(28px, 4vw, 36px);
      line-height: 1.08;
      letter-spacing: -0.04em;
    }

    .article-link {
      text-decoration: none;
    }

    .article-excerpt {
      margin-top: 16px;
      font-size: 18px;
      line-height: 1.75;
      color: var(--muted);
    }

    .tag-row {
      margin-top: 22px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .tag {
      padding: 7px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid rgba(229, 212, 177, 0.84);
      font-size: 13px;
      color: var(--muted-soft);
    }

    .read-link {
      margin-top: 28px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      font-weight: 700;
      color: var(--text);
    }

    @media (max-width: 720px) {
      .resources-page {
        width: min(100% - 32px, 1180px);
        padding-top: 52px;
        padding-bottom: 72px;
      }

      .article-card {
        padding: 24px;
      }

      .cluster-card {
        padding: 24px;
      }
    }
  </style>
</EditorialLayout>
