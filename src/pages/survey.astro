---
const title = "Focana — Quick Survey";
const description = "Tell us a little about how you found Focana and what you want it to solve.";
const canonicalURL = "https://focana.app/survey";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script>
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init('phc_vZ4qnRVsao0nnscIJsBxC8LqOpPbNns5AE9ibSYhUdr', {
        api_host: 'https://us.i.posthog.com',
        defaults: '2026-01-30'
      })
    </script>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
        background: linear-gradient(160deg, #FFFEF8 0%, #FFF9E6 50%, #FEF3C722 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .page-wrapper {
        width: 100%;
        max-width: 620px;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .card, .survey-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 24px 80px rgba(92, 64, 51, 0.12);
      }
      .card {
        padding: 34px 32px;
      }
      .survey-card {
        padding: 36px 32px;
      }
      .eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #D97706;
        margin-bottom: 10px;
      }
      h1, h2 {
        font-family: 'Outfit', sans-serif;
        color: #5C4033;
      }
      h1 {
        font-size: 28px;
        font-weight: 800;
        margin-bottom: 8px;
      }
      h2 {
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 8px;
      }
      .subtitle, .helper-text {
        color: #8B6F47;
        line-height: 1.6;
      }
      .subtitle {
        font-size: 15px;
      }
      .helper-box {
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        padding: 15px 16px;
        margin-top: 16px;
      }
      .helper-box strong {
        display: block;
        color: #334155;
        margin-bottom: 5px;
      }
      .helper-box p {
        color: #475569;
        font-size: 14px;
        line-height: 1.55;
      }
      .status-card {
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 20px;
        background: #F0FDF4;
        border: 1px solid #86EFAC;
      }
      .status-card[data-tone="pending"] {
        background: #FFFBEB;
        border-color: #FDE68A;
      }
      .status-card[data-tone="error"] {
        background: #FEF2F2;
        border-color: #FCA5A5;
      }
      .status-card strong {
        display: block;
        color: #14532D;
        margin-bottom: 4px;
      }
      .status-card[data-tone="pending"] strong {
        color: #92400E;
      }
      .status-card[data-tone="error"] strong {
        color: #991B1B;
      }
      .status-card p {
        font-size: 14px;
        line-height: 1.5;
        color: #166534;
      }
      .status-card[data-tone="pending"] p {
        color: #7C2D12;
      }
      .status-card[data-tone="error"] p {
        color: #7F1D1D;
      }
      .action-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 18px;
      }
      .action-btn, .skip-link {
        border-radius: 12px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
      }
      .action-btn {
        border: none;
        padding: 14px 20px;
        background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
        color: white;
        box-shadow: 0 4px 16px rgba(217, 119, 6, 0.25);
      }
      .action-btn.secondary {
        background: #FEF3C7;
        color: #5C4033;
        border: 2px solid #E5D4B1;
        box-shadow: none;
      }
      .action-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        box-shadow: none;
      }
      .survey-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        margin-bottom: 24px;
      }
      .skip-link {
        border: none;
        background: none;
        color: #8B6F47;
        padding: 4px 0;
        white-space: nowrap;
      }
      .skip-link:hover {
        color: #D97706;
        text-decoration: underline;
      }
      .survey-question {
        margin-bottom: 24px;
      }
      .question-label {
        display: block;
        font-family: 'Outfit', sans-serif;
        font-size: 15px;
        font-weight: 600;
        color: #5C4033;
        margin-bottom: 12px;
      }
      .survey-options {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .survey-option {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 10px;
        border: 1.5px solid #E5D4B1;
        background: #FFFEF8;
        cursor: pointer;
        font-size: 14px;
        color: #5C4033;
        line-height: 1.4;
      }
      .survey-option:hover {
        border-color: #D97706;
        background: #FFF9E6;
      }
      .survey-option input[type="radio"],
      .survey-option input[type="checkbox"] {
        accent-color: #F59E0B;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }
      .survey-thanks {
        display: none;
      }
      .survey-thanks.visible {
        display: block;
      }
      .survey-thanks p {
        color: #5C4033;
        font-size: 15px;
        line-height: 1.6;
      }
      @media (max-width: 520px) {
        .card, .survey-card { padding: 28px 20px; }
        .survey-header { flex-direction: column; }
        .action-row { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <div class="page-wrapper">
      <div class="card">
        <p class="eyebrow">Step 2 of 2</p>
        <h1>Your download should be starting</h1>
        <p class="subtitle">Answer these three quick questions while Focana finishes downloading. Your license key is in your Lemon receipt email and in Lemon My Orders.</p>

        <div class="status-card" id="status-card" data-tone="pending">
          <strong id="status-title">Checking your purchase context...</strong>
          <p id="status-message">We’re making sure this survey is connected to the right order before you submit it.</p>
        </div>

        <div class="helper-box">
          <strong>Where is my key?</strong>
          <p>We do not display license keys on this page. Look for your Lemon receipt email, or open Lemon My Orders to copy the key when you launch Focana.</p>
        </div>

        <div class="action-row">
          <button type="button" class="action-btn secondary" id="download-again-btn">Download again</button>
        </div>
      </div>

      <div class="survey-card" id="survey-card" style="display:none;">
        <div class="survey-header">
          <div>
            <h2>Help us make Focana stick</h2>
            <p class="helper-text">This feedback gets attached to your purchase so we can learn what brought you here and what you’ve already tried.</p>
          </div>
          <button class="skip-link" id="survey-skip" type="button">Skip</button>
        </div>

        <form id="survey-form">
          <div class="survey-question">
            <label class="question-label">1. How'd you find Focana?</label>
            <div class="survey-options">
              <label class="survey-option"><input type="radio" name="how_found" value="Reddit" /><span>Reddit</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Twitter / X" /><span>Twitter / X</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="TikTok" /><span>TikTok</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="YouTube" /><span>YouTube</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="A friend or coworker" /><span>A friend or coworker</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="An ADHD creator or coach" /><span>An ADHD creator or coach</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Product Hunt" /><span>Product Hunt</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Google search" /><span>Google search</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Blog or article" /><span>Blog or article</span></label>
              <label class="survey-option"><input type="radio" name="how_found" value="Other" /><span>Other</span></label>
            </div>
          </div>

          <div class="survey-question">
            <label class="question-label">2. What's your biggest focus struggle?</label>
            <div class="survey-options">
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I can't start tasks even when I know what to do" /><span>I can't start tasks even when I know what to do</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I lose track of what I'm working on when I switch apps" /><span>I lose track of what I'm working on when I switch apps</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I don't notice time passing until it's too late" /><span>I don't notice time passing until it's too late</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="Random thoughts pull me off track constantly" /><span>Random thoughts pull me off track constantly</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I've tried other tools and nothing sticks" /><span>I've tried other tools and nothing sticks</span></label>
              <label class="survey-option"><input type="checkbox" name="focus_struggles" value="I forget where I left off between work sessions" /><span>I forget where I left off between work sessions</span></label>
            </div>
          </div>

          <div class="survey-question">
            <label class="question-label">3. What have you tried before?</label>
            <div class="survey-options">
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Phone timers or alarms" /><span>Phone timers or alarms</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Pomodoro apps (Forest, Focus Keeper, etc.)" /><span>Pomodoro apps (Forest, Focus Keeper, etc.)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Notion / Todoist / task managers" /><span>Notion / Todoist / task managers</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Focus music (Brain.fm, Endel, lo-fi)" /><span>Focus music (Brain.fm, Endel, lo-fi)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Website blockers (Cold Turkey, Freedom)" /><span>Website blockers (Cold Turkey, Freedom)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Body doubling (Focusmate, co-working streams)" /><span>Body doubling (Focusmate, co-working streams)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Sticky notes (physical or digital)" /><span>Sticky notes (physical or digital)</span></label>
              <label class="survey-option"><input type="checkbox" name="tools_tried" value="Nothing — this is my first try" /><span>Nothing — this is my first try</span></label>
            </div>
          </div>

          <button type="submit" class="action-btn" id="survey-submit">Send and start focusing</button>
        </form>

        <div class="survey-thanks" id="survey-thanks">
          <p>Thanks. Your answers were saved to this purchase. Open the app, paste the key from your Lemon receipt email, and start your first session.</p>
        </div>
      </div>
    </div>

    <script>
      (function() {
        var urlParams = new URLSearchParams(window.location.search);
        var customerEmail = urlParams.get('email') || '';
        var orderId = urlParams.get('order_id') || '';
        var selectedChip = urlParams.get('chip') || '';

        var statusCard = document.getElementById('status-card');
        var statusTitle = document.getElementById('status-title');
        var statusMessage = document.getElementById('status-message');
        var surveyCard = document.getElementById('survey-card');
        var surveyForm = document.getElementById('survey-form');
        var surveySkip = document.getElementById('survey-skip');
        var surveySubmit = document.getElementById('survey-submit');
        var surveyThanks = document.getElementById('survey-thanks');
        var downloadAgainBtn = document.getElementById('download-again-btn');

        function phCapture(event, props) {
          if (window.posthog) window.posthog.capture(event, props);
        }

        function setStatus(tone, title, message) {
          statusCard.setAttribute('data-tone', tone);
          statusTitle.textContent = title;
          statusMessage.textContent = message;
        }

        function showSurvey() {
          surveyCard.style.display = 'block';
        }

        function showThanks() {
          surveyForm.style.display = 'none';
          surveySkip.style.display = 'none';
          surveyThanks.classList.add('visible');
        }

        function hasKnownChip() {
          return selectedChip === 'apple_silicon' || selectedChip === 'intel';
        }

        function startDownload(downloadUrl) {
          var anchor = document.createElement('a');
          anchor.href = downloadUrl;
          anchor.rel = 'noopener';
          anchor.style.display = 'none';
          document.body.appendChild(anchor);
          anchor.click();
          document.body.removeChild(anchor);
        }

        async function requestDownloadLinks() {
          var response = await fetch('/api/download-links?order_id=' + encodeURIComponent(orderId) + '&email=' + encodeURIComponent(customerEmail));
          var payload = await response.json();
          if (!response.ok) {
            throw new Error(payload.error || ('Request failed with status ' + response.status));
          }
          return payload;
        }

        async function verifySurveyContext() {
          if (!customerEmail || !orderId) {
            setStatus('error', 'We could not verify this survey', 'Re-open the purchase link from your Lemon receipt email so we can attach your answers to the right order.');
            return;
          }

          try {
            var payload = await requestDownloadLinks();

            if (payload.status !== 'authorized') {
              setStatus('error', 'This survey link is not active', 'Use the link from your Lemon receipt email if you want to submit feedback for this purchase.');
              return;
            }

            if (!hasKnownChip()) {
              downloadAgainBtn.disabled = true;
              setStatus('ready', 'Your download should already be in progress', 'We can still save your survey answers, but Download again is disabled because we could not recover which Mac build you picked.');
            } else {
              downloadAgainBtn.disabled = false;
              setStatus('ready', 'Your download should already be in progress', 'If it did not start, use Download again below. When you open Focana, paste the key from your Lemon receipt email or Lemon My Orders.');
            }
            showSurvey();
          } catch (error) {
            console.error('Failed to verify survey context:', error);
            setStatus('error', 'We could not verify this survey', 'Refresh the page or contact support if this purchase should still be active.');
          }
        }

        if (!customerEmail || !orderId || !selectedChip) {
          try {
            var storedContext = window.sessionStorage.getItem('focana_purchase_context');
            if (storedContext) {
              var parsedContext = JSON.parse(storedContext);
              if (!customerEmail && parsedContext.email) customerEmail = parsedContext.email;
              if (!orderId && parsedContext.orderId) orderId = parsedContext.orderId;
              if (!selectedChip && parsedContext.chip) selectedChip = parsedContext.chip;
            }
          } catch (err) {
            console.error('Failed to read stored purchase context:', err);
          }
        }

        phCapture('survey_page_viewed', {
          email: customerEmail,
          order_id: orderId,
          chip: selectedChip || 'unknown'
        });

        downloadAgainBtn.addEventListener('click', async function() {
          if (!hasKnownChip()) {
            setStatus('error', 'We could not determine your Mac build', 'Go back to the verified download page and pick Apple Silicon or Intel again if you need a fresh download.');
            return;
          }

          downloadAgainBtn.disabled = true;
          downloadAgainBtn.textContent = 'Preparing...';

          try {
            var payload = await requestDownloadLinks();
            if (payload.status !== 'authorized') {
              throw new Error('Download link is not currently authorized.');
            }

            var downloadUrl = selectedChip === 'intel' ? payload.x64Url : payload.arm64Url;
            if (!downloadUrl) {
              throw new Error('The selected download is not available.');
            }

            phCapture('download_again_clicked', {
              email: customerEmail,
              order_id: orderId,
              chip: selectedChip
            });
            startDownload(downloadUrl);
          } catch (error) {
            console.error('Failed to re-download:', error);
            setStatus('error', 'Could not start the download again', 'Refresh the page or contact support if the signed download link expired.');
          } finally {
            downloadAgainBtn.disabled = false;
            downloadAgainBtn.textContent = 'Download again';
          }
        });

        surveySkip.addEventListener('click', function() {
          phCapture('survey_skipped', { email: customerEmail, order_id: orderId, chip: selectedChip || 'unknown' });
          showThanks();
        });

        surveyForm.addEventListener('submit', function(event) {
          event.preventDefault();
          surveySubmit.disabled = true;
          surveySubmit.textContent = 'Sending...';

          var howFoundEl = surveyForm.querySelector('input[name="how_found"]:checked');
          var howFound = howFoundEl ? howFoundEl.value : null;
          var focusStruggles = [];
          var toolsTried = [];

          surveyForm.querySelectorAll('input[name="focus_struggles"]:checked').forEach(function(cb) {
            focusStruggles.push(cb.value);
          });

          surveyForm.querySelectorAll('input[name="tools_tried"]:checked').forEach(function(cb) {
            toolsTried.push(cb.value);
          });

          phCapture('survey_completed', {
            email: customerEmail,
            order_id: orderId,
            chip: selectedChip || 'unknown',
            how_found: howFound,
            focus_struggles: focusStruggles,
            tools_tried: toolsTried
          });

          fetch('/api/survey', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: customerEmail,
              order_id: orderId,
              how_found: howFound,
              focus_struggles: focusStruggles,
              tools_tried: toolsTried
            })
          }).then(function(response) {
            if (!response.ok) {
              return response.text().then(function(text) {
                throw new Error(text || ('Request failed with status ' + response.status));
              });
            }
            showThanks();
          }).catch(function(error) {
            console.error('Survey submit failed:', error);
            setStatus('error', 'We could not save your answers', 'Please try again. Your download is still available through Download again above.');
            surveySubmit.disabled = false;
            surveySubmit.textContent = 'Try sending again';
          });
        });

        verifySurveyContext();
      })();
    </script>
  </body>
</html>
